{
  "additionalProperties": false,
  "properties": {
    "available_at": {
      "format": "date-time",
      "title": "Available At",
      "type": "string"
    },
    "collected_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Collected At"
    },
    "data_mode": {
      "default": "synthetic_fixture",
      "enum": [
        "synthetic_fixture",
        "historical_replay",
        "live_forward"
      ],
      "title": "Data Mode",
      "type": "string"
    },
    "effective_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Effective At"
    },
    "factor_id": {
      "pattern": "^[a-z][a-z0-9_-]*$",
      "title": "Factor Id",
      "type": "string"
    },
    "market_timezone": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Market Timezone"
    },
    "observation_id": {
      "format": "uuid",
      "title": "Observation Id",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "published_at": {
      "format": "date-time",
      "title": "Published At",
      "type": "string"
    },
    "released_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Released At"
    },
    "revision_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Revision Id",
      "type": "string"
    },
    "source_id": {
      "pattern": "^[a-z][a-z0-9_-]*$",
      "title": "Source Id",
      "type": "string"
    },
    "source_ref": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Ref"
    },
    "time_precision": {
      "default": "second",
      "enum": [
        "date",
        "second"
      ],
      "title": "Time Precision",
      "type": "string"
    },
    "unit": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Unit",
      "type": "string"
    },
    "value": {
      "title": "Value",
      "type": "number"
    }
  },
  "required": [
    "observation_id",
    "factor_id",
    "source_id",
    "revision_id",
    "unit",
    "value",
    "observed_at",
    "published_at",
    "available_at"
  ],
  "title": "Observation",
  "type": "object"
}
